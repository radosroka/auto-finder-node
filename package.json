{
  "name": "auto-finder",
  "version": "1.0.1",
  "description": "Car finder desktop application",
  "author": {
    "name": "Radovan Sroka",
    "email": "radovan.sroka@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "web": "node start.js"
  },
  "build": {
    "appId": "com.autofinder.app",
    "productName": "Auto Finder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "routes/**",
      "views/**",
      "public/**",
      "user/**",
      "db/**",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    },
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "npmRebuild": true
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.2",
    "pug": "^3.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  }
}
