{
  "name": "auto-finder",
  "version": "1.0.0",
  "description": "Car finder desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "web": "node start.js"
  },
  "build": {
    "appId": "com.autofinder.app",
    "productName": "Auto Finder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app.js",
      "routes/**",
      "views/**",
      "public/**",
      "user/**",
      "db/**",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "npmRebuild": true
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "body-parser": "^1.20.1",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^1.4.0",
    "express": "^4.18.2",
    "express-promise-router": "^4.1.1",
    "express-session": "^1.17.3",
    "express-validator": "^6.14.3",
    "pug": "^3.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  }
}
