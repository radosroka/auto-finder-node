extends layout

block content
  -data = data || {}

  hr

  form(action="/query" method="POST" class="form-registration")
    div(class="container")
      div(class="row")
        div(class="col-sm")
          label(for="car_plate") Car Plate:
          input(
            type="text"
            id="car_plate"
            name="car_plate"
            class="form-control"
            value=data.car_plate
          )

          label(for="car_model") Car Model:
          input(
            type="text"
            id="car_model"
            name="car_model"
            class="form-control"
            value=data.car_model
            )

          label(for="type_name") Type Name:
          input(
            type="text"
            id="type_name"
            name="type_name"
            class="form-control"
            value=data.type_name
            )

        div(class="col-sm")
          label(for="car_color") Car Color:
          input(
            type="text"
            id="car_color"
            name="car_color"
            class="form-control"
            value=data.car_color
            )

          div
            label(for="car_year_from") Car Year From:
            input(
              type="text"
              id="car_year_from"
              name="car_year_from"
              class="form-control"
              value=data.car_year_from
              )


            label(for="car_year_to") Car Year To:
            input(
              type="text"
              id="car_year_to"
              name="car_year_to"
              class="form-control"
              value=data.car_year_to
              )

      hr

      if errors
        ul.my-errors
          for error in errors
            li= error.msg

      div(class="row")
        div(class="col-lg")
          input(
            type="submit"
            value="Search"
            class="btn btn-lg btn-primary btn-block"
            )

  hr

  p Found #{rows.length} entries.

  - var biluppgifter_link = 'https://biluppgifter.se/fordon/'
  - var onePage = 100
  - var pages = 1
  - if (rows.length > onePage) { pages += Math.floor( rows.length / onePage) }
  - pages = new Array(pages).fill(1).map( (_, i) => i+1 )

  - var _hidden = false
  for page in pages


    if (page) == 2
      - _hidden = true

    p(hidden=_hidden) PAGE #{page}

    table(class="table table-striped table-hover table-sm" hidden=_hidden)

      tr
        th(scope="col") #
        th(scope="col") car_plate
        th(scope="col") car_model
        th(scope="col") type_name
        th(scope="col") car_color
        th(scope="col") car_year

        - var i = 0
        for x in rows.slice((page-1) * onePage, (page-1) * onePage + onePage )
          - i = i + 1
          tr
            th(scope="col") #{(page-1) * onePage + i}
            td(scope="col")
              a(href=biluppgifter_link + x[0], target="_blank") #{x[0]}
            td(scope="col") #{x[1]}
            td(scope="col") #{x[2]}
            td(scope="col") #{x[3]}
            td(scope="col") #{x[4]}


  nav(aria-label="...")
    ul(class=" flex-wrap pagination pagination-flush pagination-gap")
      li(class="page-item disabled")
        a(class="page-link" href="#" tabindex="-1") Previous

      - var li_class = "page-item"
      - var active = li_class + " active"
      for page in pages
        if (page) == 1
          li(class=active)
            a(class="page-link" href="#") #{page}
              span(class="sr-only") (current)
        else
          li(class=li_class)
            a(class="page-link" href="#") #{page}


      li(class="page-item")
        a(class="page-link" href="#") Next
