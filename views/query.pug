extends layout

block content
  -data = data || {}

  link(rel='stylesheet', href='/css/query.css')
  script(src='/js/query-selector.js')

  if searchForm
    hr
    form(action="/query" method="POST" class="form-registration")
      div(class="container")
        div(class="row")
          div(class="col-sm")
            label(for="car_plate") Car Plate:
            input(
              type="text"
              id="car_plate"
              name="car_plate"
              class="form-control"
              value=data.car_plate
            )

            label(for="car_model") Car Model:
            input(
              type="text"
              id="car_model"
              name="car_model"
              class="form-control"
              value=data.car_model
            )

            label(for="type_name") Type Name:
            input(
              type="text"
              id="type_name"
              name="type_name"
              class="form-control"
              value=data.type_name
            )

          div(class="col-sm")
            label(for="car_color") Car Color:
            input(
              type="text"
              id="car_color"
              name="car_color"
              class="form-control"
              value=data.car_color
            )

            div
              label(for="car_year_from") Car Year From:
              input(
                type="text"
                id="car_year_from"
                name="car_year_from"
                class="form-control"
                value=data.car_year_from
              )


              label(for="car_year_to") Car Year To:
              input(
                type="text"
                id="car_year_to"
                name="car_year_to"
                class="form-control"
                value=data.car_year_to
              )

      hr

      if errors
        ul.my-errors
          for error in errors
            li= error.msg

      div(class="row")
        div(class="col-lg")
          input(
            type="submit"
            value="Search"
            class="btn btn-md btn-primary btn-block"
            )

  hr

  if searchForm
    div(id="context_menu_lists")
      for l in custom_lists
        div(class="item" list_id=l[0]) #{l[1]} (#{l[2]})

  p Found #{pagination.total} entries. Showing page #{pagination.page} of #{pagination.totalPages}.

  if pagination && pagination.totalPages > 1
    - var qstr = encodeURIComponent(pagination.queryString)
    - var cp = pagination.page
    - var tp = pagination.totalPages
    nav(aria-label="Page navigation")
      ul(class="pagination pagination-sm flex-wrap")
        li(class=`page-item${cp === 1 ? ' disabled' : ''}`)
          a(class="page-link" href=`/query?query=${qstr}&page=${cp - 1}`) &laquo; Prev
        - if (cp > 3)
          li(class="page-item")
            a(class="page-link" href=`/query?query=${qstr}&page=1`) 1
        - if (cp > 4)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - for (var p = Math.max(1, cp - 2); p <= Math.min(tp, cp + 2); p++)
          li(class=`page-item${cp === p ? ' active' : ''}`)
            a(class="page-link" href=`/query?query=${qstr}&page=${p}`) #{p}
        - if (cp < tp - 3)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - if (cp < tp - 2)
          li(class="page-item")
            a(class="page-link" href=`/query?query=${qstr}&page=${tp}`) #{tp}
        li(class=`page-item${cp === tp ? ' disabled' : ''}`)
          a(class="page-link" href=`/query?query=${qstr}&page=${cp + 1}`) Next &raquo;

  table(class="table table-striped table-hover table-sm")
    tr
      th(scope="col") #
      th(scope="col") car_plate
      th(scope="col") car_model
      th(scope="col") type_name
      th(scope="col") car_color
      th(scope="col") car_year

    - var biluppgifter_link = 'https://biluppgifter.se/fordon/'
    - var threshold = 24191006;
    - var i = 0;
    - var clickable_class = "clickable-query-row";
    - var offset = pagination ? (pagination.page - 1) * pagination.perPage : 0;
    for x in rows
      - i = i + 1
      - var tr_class = clickable_class
      - if (x[5] > threshold) tr_class += " table-success"
      tr(class=tr_class id=x[5])
        th(scope="col") #{offset + i}
        td(scope="col")
          a(href=biluppgifter_link + x[0], target="_blank") #{x[0]}
        td(scope="col") #{x[1]}
        td(scope="col") #{x[2]}
        td(scope="col") #{x[3]}
        td(scope="col") #{x[4]}

  if pagination && pagination.totalPages > 1
    nav(aria-label="Page navigation" class="mt-2")
      ul(class="pagination pagination-sm flex-wrap")
        li(class=`page-item${cp === 1 ? ' disabled' : ''}`)
          a(class="page-link" href=`/query?query=${qstr}&page=${cp - 1}`) &laquo; Prev
        - if (cp > 3)
          li(class="page-item")
            a(class="page-link" href=`/query?query=${qstr}&page=1`) 1
        - if (cp > 4)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - for (var p = Math.max(1, cp - 2); p <= Math.min(tp, cp + 2); p++)
          li(class=`page-item${cp === p ? ' active' : ''}`)
            a(class="page-link" href=`/query?query=${qstr}&page=${p}`) #{p}
        - if (cp < tp - 3)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - if (cp < tp - 2)
          li(class="page-item")
            a(class="page-link" href=`/query?query=${qstr}&page=${tp}`) #{tp}
        li(class=`page-item${cp === tp ? ' disabled' : ''}`)
          a(class="page-link" href=`/query?query=${qstr}&page=${cp + 1}`) Next &raquo;
