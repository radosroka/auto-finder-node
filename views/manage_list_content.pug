extends layout

block content
  -data = data || {}

  link(rel='stylesheet', href='/css/query.css')
  script(src='/js/query-selector.js')

  p Found #{pagination.total} entries. Showing page #{pagination.page} of #{pagination.totalPages}.

  if pagination && pagination.totalPages > 1
    - var cp = pagination.page
    - var tp = pagination.totalPages
    - var lid = pagination.list_id
    nav(aria-label="Page navigation")
      ul(class="pagination pagination-sm flex-wrap")
        li(class=`page-item${cp === 1 ? ' disabled' : ''}`)
          a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${cp - 1}`) &laquo; Prev
        - if (cp > 3)
          li(class="page-item")
            a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=1`) 1
        - if (cp > 4)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - for (var p = Math.max(1, cp - 2); p <= Math.min(tp, cp + 2); p++)
          li(class=`page-item${cp === p ? ' active' : ''}`)
            a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${p}`) #{p}
        - if (cp < tp - 3)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - if (cp < tp - 2)
          li(class="page-item")
            a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${tp}`) #{tp}
        li(class=`page-item${cp === tp ? ' disabled' : ''}`)
          a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${cp + 1}`) Next &raquo;

  table(class="table table-striped table-hover table-sm")
    tr
      th(scope="col") #
      th(scope="col") car_plate
      th(scope="col") car_model
      th(scope="col") type_name
      th(scope="col") car_color
      th(scope="col") car_year
      th(scope="col") owner_name
      th(scope="col") owner_age
      th(scope="col") owner_address
      th(scope="col") owner_phone
      th(scope="col") operation

    - var biluppgifter_link = 'https://biluppgifter.se/fordon/'
    - var threshold = 24191066 / 2;
    - var i = 0;
    - var clickable_class = "clickable-query-row";
    - var offset = (pagination.page - 1) * pagination.perPage;
    for x in rows
      - i = i + 1
      - var tr_class = clickable_class
      - if (x[6] < threshold) tr_class += " table-success"
      tr(class=tr_class id=x[6])
        th(scope="col") #{offset + i}
        td(scope="col")
          a(href=biluppgifter_link + x[0], target="_blank") #{x[0]}
        td(scope="col") #{x[1]}
        td(scope="col") #{x[2]}
        td(scope="col") #{x[3]}
        td(scope="col") #{x[4]}
        td(scope="col")
          a(href=x[11], target="_blank") #{x[5]}
        td(scope="col") #{x[6]}
        if x[7]
          td(scope="col") #{x[7]}, #{x[8]} #{x[9]}
        else
          td(scope="col") #{x[7]} #{x[8]} #{x[9]}
        td(scope="col") #{x[10]}
        td(scope="col")
          a(href="/manage_list_content?operation=delete&list_id=" + x[12] + "&car_id=" + x[13])
            button(type="submit" class="btn btn-sm btn-danger") Delete

  if pagination && pagination.totalPages > 1
    nav(aria-label="Page navigation" class="mt-2")
      ul(class="pagination pagination-sm flex-wrap")
        li(class=`page-item${cp === 1 ? ' disabled' : ''}`)
          a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${cp - 1}`) &laquo; Prev
        - if (cp > 3)
          li(class="page-item")
            a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=1`) 1
        - if (cp > 4)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - for (var p = Math.max(1, cp - 2); p <= Math.min(tp, cp + 2); p++)
          li(class=`page-item${cp === p ? ' active' : ''}`)
            a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${p}`) #{p}
        - if (cp < tp - 3)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - if (cp < tp - 2)
          li(class="page-item")
            a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${tp}`) #{tp}
        li(class=`page-item${cp === tp ? ' disabled' : ''}`)
          a(class="page-link" href=`/manage_list_content?list_id=${lid}&page=${cp + 1}`) Next &raquo;

  if query.list_id
    a(href="/manage_list_content?operation=export&list_id=" + query.list_id)
      button(type="submit" class="btn btn-lg btn-danger") Export
