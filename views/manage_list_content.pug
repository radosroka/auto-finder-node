extends layout

block content
  -data = data || {}

  link(rel='stylesheet', href='/css/query.css')
  script(src='/js/query-selector.js')

  p Found #{rows.length} entries.

  table(class="table table-striped table-hover table-sm")
    tr
      th(scope="col") #
      th(scope="col") car_plate
      th(scope="col") car_model
      th(scope="col") type_name
      th(scope="col") car_color
      th(scope="col") car_year
      th(scope="col") owner_name
      th(scope="col") owner_age
      th(scope="col") owner_address
      th(scope="col") owner_phone
      th(scope="col") operation

    - var biluppgifter_link = 'https://biluppgifter.se/fordon/'
    - var threshold = 24191066 / 2;
    - var i = 0;
    - var clickable_class = "clickable-query-row";
    for x in rows
      - i = i + 1
      - var tr_class = clickable_class
      - if (x[6] < threshold) tr_class += " table-success"
      tr(class=tr_class id=x[6])
        th(scope="col") #{i}
        td(scope="col")
          a(href=biluppgifter_link + x[0], target="_blank") #{x[0]}
        td(scope="col") #{x[1]}
        td(scope="col") #{x[2]}
        td(scope="col") #{x[3]}
        td(scope="col") #{x[4]}
        td(scope="col")
          a(href=x[11], target="_blank") #{x[5]}
        td(scope="col") #{x[6]}
        td(scope="col") #{x[7]} #{x[8]} #{x[9]}
        td(scope="col") #{x[10]}
        td(scope="col")
          a(href="/manage_list_content?operation=delete&list_id=" + x[12] + "&car_id=" + x[13])
            button(type="submit" class="btn btn-sm btn-danger") Delete
