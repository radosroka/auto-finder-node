extends layout

block content
  -data = data || {}



  form(action="./login" method="POST" class="form-registration")
    label(for="logname") Log Name:
    input(
      type="text"
      id="logname"
      name="logname"
      class="form-control"
      value=data.logname
    )

    label(for="passwd") Password:
    input(
      type="password"
      id="passwd"
      name="passwd"
      class="form-control"
      value=data.passwd
    )

    hr

    if errors
      ul.my-errors
        for error in errors
          li= error

    input(
      type="submit"
      value="Login"
      class="btn btn-lg btn-primary btn-block"
      )
