extends layout

block content
  -data = data || {}

  if searchForm
    hr
    form(action="/manage_lists" method="POST" class="form-registration")
      div(class="container")
        div(class="row")
          div(class="col-sm")
            label(for="new_list_name") New List Name:
            input(
              type="text"
              id="new_list_name"
              name="new_list_name"
              class="form-control"
              value=data.new_list_name
            )
          div(class="col-sm")


        div(class="row")
          div(class="col-sm")
            hr
            input(
              type="submit"
              value="Create"
              class="btn btn-md btn-primary btn-block"
            )
          div(class="col-sm")


      hr

      if errors
        ul.my-errors
          for error in errors
            li= error.msg



  hr

  p Found #{pagination.total} entries. Showing page #{pagination.page} of #{pagination.totalPages}.

  if pagination && pagination.totalPages > 1
    - var cp = pagination.page
    - var tp = pagination.totalPages
    nav(aria-label="Page navigation")
      ul(class="pagination pagination-sm flex-wrap")
        li(class=`page-item${cp === 1 ? ' disabled' : ''}`)
          a(class="page-link" href=`/manage_lists?page=${cp - 1}`) &laquo; Prev
        - if (cp > 3)
          li(class="page-item")
            a(class="page-link" href=`/manage_lists?page=1`) 1
        - if (cp > 4)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - for (var p = Math.max(1, cp - 2); p <= Math.min(tp, cp + 2); p++)
          li(class=`page-item${cp === p ? ' active' : ''}`)
            a(class="page-link" href=`/manage_lists?page=${p}`) #{p}
        - if (cp < tp - 3)
          li(class="page-item disabled")
            span(class="page-link") &hellip;
        - if (cp < tp - 2)
          li(class="page-item")
            a(class="page-link" href=`/manage_lists?page=${tp}`) #{tp}
        li(class=`page-item${cp === tp ? ' disabled' : ''}`)
          a(class="page-link" href=`/manage_lists?page=${cp + 1}`) Next &raquo;

  table(class="table table-striped table-hover table-sm")
    tr
      th(scope="col") #
      th(scope="col") list_name
      th(scope="col") Entries
      th(scope="col") Operation

    - var i = 0
    - var offset = (pagination.page - 1) * pagination.perPage
    for x in rows
      - i = i + 1
      tr(class="clicable-query-row")
        th(scope="col") #{offset + i}
        td(scope="col")
          a(href="/manage_list_content?list_id=" + x[0], target="_blank") #{x[1]}
        td(scope="col") #{x[2]}
        td(scope="col")
          a(href="/manage_lists?operation=delete&list_id=" + x[0])
            button(type="submit" class="btn btn-sm btn-danger") Delete
