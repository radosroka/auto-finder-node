extends layout

block content
  -data = data || {}

  if errors
    ul.my-errors
      for error in errors
        li= error.msg

  form(action="." method="POST" class="form-registration")
    label(for="username") User Name:
    input(
      type="text"
      id="username"
      name="usernane"
      class="form-control"
      value=data.username
    )

    label(for="passwd") Password:
    input(
      type="password"
      id="passwd"
      name="passwd"
      class="form-control"
      value=data.passwd
    )

    input(
      type="submit"
      value="Login"
      class="btn btn-lg btn-primary btn-block"
      )
