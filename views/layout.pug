doctype html
html(style="padding: 2%")
  head
    title= `${title}`
    link(rel='stylesheet', href='/css/bootstrap.min.css')
    script(src='/js/bootstrap.bundle.min.js')
    script(src='/js/jquery-3.6.0.min.js')

  body
    h1(style="color: #FFF") Biluppgifter

    nav(class="navbar  navbar-dark bg-dark fixed-top")
      div(class="container-fluid")
        a(class="navbar-brand" href="/query") Biluppgifter

        if session && session.user
          span(class="navbar-text") User: #{session.user}

        button(class="navbar-toggler collapsed"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNavDropdown"
          aria-controls="navbarNavDropdown"
          aria-expanded="false"
          aria-label="Toggle navigation")
            span(class="navbar-toggler-icon")
        if session && session.user
          div(class="collapse navbar-collapse" id="navbarNavDropdown")
            ul(class="navbar-nav")
              li(class="nav-item dropdown")
                a(class="nav-link dropdown-toggle"
                  id="navbarDropdownMenuLink"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  href="#") Lists
                ul(class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink" style="max-height: 70vh; overflow-y: auto;")
                  li
                    a(class="dropdown-item" href="/manage_lists") Manage Lists

                  hr

                  for l in custom_lists
                    li
                      a(class="dropdown-item" href="/manage_list_content?list_id=" + l[0]) #{l[1]} (#{l[2]})

              li(class="nav-item dropdown")
                a(class="nav-link dropdown-toggle"
                  id="navbarDropdownDatabase"
                  role="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  href="#") Database
                ul(class="dropdown-menu" aria-labelledby="navbarDropdownDatabase")
                  li
                    a(class="dropdown-item" href="#" id="exportDbBtn") Export Database
                  li
                    a(class="dropdown-item" href="#" id="importDbBtn") Import Database

              li(class="nav-item")
                a(class="nav-link" href="/logout") Log out

    script.
      document.addEventListener('DOMContentLoaded', function () {
        var exportBtn = document.getElementById('exportDbBtn');
        var importBtn = document.getElementById('importDbBtn');
        if (exportBtn) {
          exportBtn.addEventListener('click', function (e) {
            e.preventDefault();
            if (window.electronAPI) window.electronAPI.exportDb();
          });
        }
        if (importBtn) {
          importBtn.addEventListener('click', function (e) {
            e.preventDefault();
            if (window.electronAPI) window.electronAPI.importDb();
          });
        }
      });

  block content
